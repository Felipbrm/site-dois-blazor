@page "/sorteio"
@rendermode InteractiveServer

<h3>Sorteador de Números</h3>

<button @onclick="SorteiaNumero">Gerar Número Aleatório</button>

@if (numeroSorteado != null)
{
    <h2>@numeroSorteado</h2>
}

@code {
    private int? numeroSorteado;

    private void SorteiaNumero()
    {
        Random rnd = new Random();
        numeroSorteado = rnd.Next(1, 101);
    }
}